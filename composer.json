{
  "name": "monnify/monnify-php",
  "description": "Framework-agnostic PHP SDK for the Monnify API",
  "type": "library",
  "homepage": "https://github.com/Monnify/Monnify-PHP-SDK",
  "keywords": [
    "monnify",
    "payments",
    "php-sdk",
    "payment-gateway"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0|^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Monnify\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Monnify\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --debug"
  },
  "config": {
    "sort-packages": true
  }
}
